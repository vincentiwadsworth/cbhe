---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
---

<BaseLayout title="Quiénes Somos | CBHE">
  <section class="relative bg-gradient-to-br from-primary to-primary-container pt-32 pb-48 px-8 overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[url('https://images.unsplash.com/photo-1518770660439-4636190af475?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80')] bg-cover bg-center mix-blend-overlay"></div>
    <div class="max-w-7xl mx-auto relative z-10 flex flex-col md:flex-row items-center gap-16">
      <div class="flex-1 space-y-8">
        <span class="text-primary-fixed-dim font-bold tracking-widest uppercase text-sm">Institucional</span>
        <h1 class="text-5xl md:text-6xl font-headline font-extrabold text-on-primary leading-tight tracking-tight">
          Sobre la Cámara Boliviana de Hidrocarburos y Energía
        </h1>
        <p class="text-lg md:text-xl text-on-primary-container font-body leading-relaxed max-w-2xl">
          Representamos la fuerza impulsora del sector energético en Bolivia. Unimos a las principales empresas para garantizar un desarrollo sostenible, riguroso y transparente de nuestros recursos estratégicos.
        </p>
      </div>
      <div class="flex-1 hidden md:block">
        <div class="relative w-full aspect-square max-w-md ml-auto">
          <div class="absolute inset-0 bg-surface/10 backdrop-blur-md rounded-xl border border-surface/20 transform rotate-3"></div>
          <div class="absolute inset-4 bg-surface/20 backdrop-blur-xl rounded-xl border border-surface/30 transform -rotate-2"></div>
          <div class="absolute inset-8 bg-[url('https://images.unsplash.com/photo-1541888053-1563f1396a92?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80')] bg-cover bg-center rounded-lg shadow-2xl"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Misión & Visión -->
  <section class="max-w-7xl mx-auto px-8 -mt-24 relative z-20 mb-32">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="bg-surface-container-lowest p-12 rounded-xl shadow-[0_8px_24px_rgba(0,28,59,0.06)] hover:bg-surface-container-lowest transition-colors duration-300">
        <div class="w-16 h-16 bg-surface-container-low rounded-lg flex items-center justify-center mb-8">
          <span class="material-symbols-outlined text-3xl text-primary" style="font-variation-settings: 'FILL' 1;">flag</span>
        </div>
        <h2 class="text-3xl font-headline font-bold text-on-surface mb-6">Nuestra Misión</h2>
        <p class="text-body text-on-surface-variant leading-relaxed text-lg">
          Promover el desarrollo eficiente, competitivo y sostenible del sector de hidrocarburos y energía en Bolivia. Representamos y defendemos los intereses de nuestros afiliados a través de la excelencia técnica, el diálogo constructivo y la proposición de políticas públicas basadas en el rigor científico y económico.
        </p>
      </div>

      <div class="bg-surface-container-low p-12 rounded-xl shadow-[0_8px_24px_rgba(0,28,59,0.06)] hover:bg-surface-container-highest transition-colors duration-300 md:mt-16">
        <div class="w-16 h-16 bg-surface-container-lowest rounded-lg flex items-center justify-center mb-8">
          <span class="material-symbols-outlined text-3xl text-primary" style="font-variation-settings: 'FILL' 1;">visibility</span>
        </div>
        <h2 class="text-3xl font-headline font-bold text-on-surface mb-6">Nuestra Visión</h2>
        <p class="text-body text-on-surface-variant leading-relaxed text-lg">
          Ser el referente institucional indiscutible del sector energético boliviano a nivel nacional e internacional. Aspiramos a liderar la transición hacia una matriz energética moderna, consolidando a Bolivia como un actor clave mediante la innovación tecnológica y las mejores prácticas operativas globales.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
