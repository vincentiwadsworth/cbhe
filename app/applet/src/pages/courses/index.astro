---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
---

<BaseLayout title="Capacitación - CBHE">
  <section class="relative pt-32 pb-24 px-8 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-primary to-primary-container opacity-5"></div>
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="space-y-8 z-10 relative">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-surface-container-high rounded-full">
          <span class="material-symbols-outlined text-primary text-sm">school</span>
          <span class="text-xs font-semibold text-primary uppercase tracking-wider">Formación Continua</span>
        </div>
        <h1 class="text-5xl md:text-6xl font-headline font-bold text-on-surface leading-[1.1] tracking-tight">
          Centro de Formación y Certificación
        </h1>
        <p class="text-lg md:text-xl text-on-surface-variant leading-relaxed max-w-xl">
          Desarrollando el talento y elevando los estándares técnicos del sector energético a través de programas especializados y certificaciones de clase mundial.
        </p>
      </div>
      <div class="relative z-10 hidden lg:block">
        <div class="aspect-[4/3] rounded-xl overflow-hidden shadow-2xl relative">
          <Image inferSize={true} alt="Ingenieros en entrenamiento" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCQquKpn8AuYAgAKnfFf8gINHBoa-rSoEErpFGPBdjJ5o8Gj77vhDjZ9sKEczS9eSJEnWtkAPQRJwXcVw-eBBanXCOeW0vJWO7gjLpgkfNtNNQ4Qx-FRH6cki4VB1-29a8EfWw6BMYe1x6vNfymxWVyl1KSFAMZNgT8Im06aEblh1kq9w7SI0-I1T3BAbcOewp9wdANhWvcXE7I__jUwpLYXSiFoen6x8DNd1gnLsj3_TeWe0L_jeNsFs2ZiMLWFrSZlpJHETf0h-A"/>
          <div class="absolute inset-0 bg-gradient-to-t from-primary/80 to-transparent mix-blend-multiply"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Filtros -->
  <section class="py-12 bg-surface-container-low border-y border-outline-variant/15" id="catalogo">
    <div class="max-w-7xl mx-auto px-8">
      <div class="flex flex-col md:flex-row gap-6 justify-between items-center bg-surface p-4 rounded-lg shadow-sm border border-outline-variant/10">
        <div class="relative w-full md:w-96">
          <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">search</span>
          <input class="w-full bg-surface-container-low border-none rounded-DEFAULT py-3 pl-12 pr-4 text-on-surface focus:ring-2 focus:ring-primary focus:bg-surface transition-all placeholder:text-outline" placeholder="Buscar programas, instructores..." type="text"/>
        </div>
        <div class="flex gap-2 w-full md:w-auto overflow-x-auto pb-2 md:pb-0 scrollbar-hide">
          <button class="whitespace-nowrap px-4 py-2 bg-primary-container text-on-primary rounded-full text-sm font-medium transition-colors">Todos</button>
          <button class="whitespace-nowrap px-4 py-2 bg-surface-container-high text-on-surface-variant hover:bg-surface-variant rounded-full text-sm font-medium transition-colors">Técnico</button>
          <button class="whitespace-nowrap px-4 py-2 bg-surface-container-high text-on-surface-variant hover:bg-surface-variant rounded-full text-sm font-medium transition-colors">Ambiental</button>
        </div>
      </div>
    </div>
  </section>
  <section class="py-24 px-8 bg-background">
      <div class="max-w-7xl mx-auto text-center h-[300px]">
         <h2 class="text-3xl font-headline font-bold text-on-surface">Próximos Programas (Se alimentan desde Pages CMS)</h2>
      </div>
  </section>
</BaseLayout>
