---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const blogEntries = await getCollection('blog');
---

<BaseLayout title="Novedades - CBHE">
  <header class="py-16 px-8 max-w-7xl mx-auto">
    <h1 class="text-[56px] leading-tight font-bold text-on-background font-headline tracking-tight max-w-3xl">Sala de Prensa y Novedades</h1>
    <p class="text-xl text-on-surface-variant mt-6 max-w-2xl leading-relaxed font-body">Manténgase informado sobre los últimos desarrollos, análisis y eventos del sector energético e hidrocarburos.</p>
  </header>

  <main class="max-w-7xl mx-auto px-8 pb-24 grid grid-cols-1 lg:grid-cols-4 gap-12">
    <!-- Contenido Principal -->
    <div class="lg:col-span-3 space-y-12">
      <!-- Grid de Noticias usando Colecciones -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {blogEntries.length === 0 ? (
          <p class="text-on-surface-variant">No hay noticias publicadas por el momento.</p>
        ) : blogEntries.map(entry => (
          <article class="bg-surface-container-low p-6 rounded-lg transition-all duration-300 hover:bg-surface-container-highest flex flex-col">
            <h3 class="text-xl font-semibold text-on-background mb-3 font-headline leading-snug">{entry.data.title}</h3>
            <p class="text-base text-on-surface-variant leading-relaxed font-body flex-grow">{entry.data.description}</p>
            <div class="mt-6 flex items-center justify-between text-sm text-on-surface-variant border-t border-outline-variant/15 pt-4">
              <span>{entry.data.pubDate.toLocaleDateString()}</span>
              <a href={`${import.meta.env.BASE_URL}/blog/${entry.slug}`} class="text-primary font-medium hover:underline">Leer más →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
